# Скопіюйте цей файл у backend/.env і заповніть значення.
# backend/.env у git НЕ потрапляє (див. .gitignore) — не комітьте токени.

# Токен від @BotFather. НІКОЛИ не давайте йому префікс REACT_APP_ —
# такі змінні CRA вшиває у публічний бандл у відкритому вигляді.
TELEGRAM_BOT_TOKEN=

# ID групи, куди бот публікує заявки. Від'ємне число, напр. -1001234567890.
# Дізнатись: додайте бота в групу і подивіться chat.id у логах update.
TELEGRAM_GROUP_CHAT_ID=

# Telegram user id адміністраторів через кому. Дізнатись свій: @userinfobot
ADMIN_TELEGRAM_IDS=

# Спільний секрет для заголовка X-Admin-Token у DELETE-запитах до API.
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Рядок підключення до БД. Для переходу на PostgreSQL:
# postgresql+asyncpg://user:pass@localhost:5432/myapp
DATABASE_URL=sqlite+aiosqlite:///./applications.db

# Дозволені origin для CORS, через кому.
CORS_ORIGINS=http://localhost:3000

# false — підняти лише API без polling бота (використовується в тестах/CI).
RUN_BOT=true
