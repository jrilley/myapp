# Конфіг ТЕСТОВОГО інстансу. Скопіюйте у backend/.env.test
# Активується через APP_ENV=test (це робить `npm run dev:test` / `.\dev.cmd --test`).
#
# Мета: тестувати, ніяк не зачіпаючи робочого бота, робочу групу й робочий сайт.
# Тому ВСІ чотири речі нижче мають відрізнятись від backend/.env.

# --- 1. ОКРЕМИЙ БОТ (обов'язково!) -------------------------------------------
# Створіть ДРУГОГО бота в @BotFather (напр. MyApp Dev Bot).
#
# Не можна вказувати тут токен робочого бота: Telegram дозволяє лише один
# getUpdates-потік на токен. Два процеси з одним токеном дадуть 409 Conflict,
# і повідомлення користувачів почнуть випадково діставатись то одному
# інстансу, то іншому — робочий бот стане непередбачуваним.
TELEGRAM_BOT_TOKEN=

# --- 2. ОКРЕМА ГРУПА ---------------------------------------------------------
# Створіть тестову групу й додайте туди тестового бота адміністратором,
# щоб тестові заявки не летіли в робочу групу.
TELEGRAM_GROUP_CHAT_ID=

# --- 3. ОКРЕМА БАЗА ----------------------------------------------------------
# Інший файл БД: тестові заявки не потраплять на робочий сайт.
# Схему для неї треба накотити окремо:
#   Windows:  $env:APP_ENV="test"; .venv\Scripts\alembic.exe upgrade head
#   Unix:     APP_ENV=test .venv/bin/alembic upgrade head
DATABASE_URL=sqlite+aiosqlite:///./applications.test.db

# --- 4. ОКРЕМІ ПОРТИ ---------------------------------------------------------
# Тестовий сайт піднімається на :3001 (робочий — на :3000), тож CORS
# має пускати саме його. Порти виставляє скрипт запуску.
CORS_ORIGINS=http://localhost:3001

# --- Решта -------------------------------------------------------------------
# Тут можна вказати себе, щоб пробувати адмінські команди без ризику.
ADMIN_TELEGRAM_IDS=

# Свій, відмінний від робочого.
ADMIN_API_TOKEN=

RUN_BOT=true
